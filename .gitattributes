# Normalize line endings
* text=auto

# Explicit text files
*.md text diff=markdown
*.txt text
*.rs text diff=rust
*.toml text
*.js text diff=javascript
*.ts text diff=javascript
*.json text
*.yml text
*.yaml text
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.woff2 binary
